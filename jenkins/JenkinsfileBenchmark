@Library('pipeline-library@master') _

def BUILD_INFO = Artifactory.newBuildInfo()
def PROJECT_NAME = 'crypto-primitives'

// Maven
def MAVEN_RELEASE_REPO = 'libs-release-evoting-local'
def MAVEN_SNAPSHOT_REPO = 'libs-snapshot-evoting-local'
def MAVEN_RESOLVE_REPO = 'maven-evoting-virtual'
def MAVEN_PARAMS = '-T 1.5C -U --settings .mvn/settings.xml --no-transfer-progress -DskipTests'

// Tools
def JDK = 'jdk-25.0.2'
def MAVEN = 'maven-3.9.11'

def PR_ID = env.BRANCH_NAME.replace('PR-', '')

pipeline {

	agent {
		label 'apps-slaves-evoting'
	}

	options {
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '10'))
		ansiColor('xterm')
		timestamps()
	}

	tools {
		jdk "${JDK}"
		maven "${MAVEN}"
	}

    stages {
		stage('Prepare') {
			steps {
				cleanWs()
				checkout scm
			}
		}

		stage('Infos logs') {
			steps {
				echo "--------------------------------- Build Information : ---------------------------------"
				echo "Build information : ${BUILD_INFO}"
				echo "Build name : ${BUILD_INFO.name}"
				echo "Build number : ${BUILD_INFO.number}"
				echo "Build starting date : ${BUILD_INFO.startDate}"
				echo "Maven version :"
				sh "mvn -v"
				echo "Java version :"
				sh "java -version"
				echo ""
				echo "---------------------------------------------------------------------------------------"
			}
		}

		stage('Build') {
			steps {
				withEnv(["EVOTING_HOME=${env.WORKSPACE}"]) {
					mvnBuild(buildInfo: BUILD_INFO, mavenTool: MAVEN, mavenParams: MAVEN_PARAMS, releaseRepo: MAVEN_RELEASE_REPO, snapshotRepo: MAVEN_SNAPSHOT_REPO, resolveRepo: MAVEN_RESOLVE_REPO, deployArtifacts: false)
				}
			}
		}

        stage('Run Benchmarks') {
            steps {
                sh 'mvn -s .mvn/settings.xml test-compile exec:java -Dexec.mainClass="ch.post.it.evoting.cryptoprimitives.benchmark.BenchmarkRunner"'
            }
        }

        stage('Archive Results') {
            steps {
                archiveArtifacts artifacts: '**/benchmark-results*.json', allowEmptyArchive: true
            }
        }
    }

	post {
		failure {
			script {
				if (env.BRANCH_NAME == 'master' || env.BRANCH_NAME == 'develop' || env.BRANCH_NAME.startsWith('maintenance'))
				{
					def projectUrl = env.BUILD_URL
					def projectName = env.JOB_NAME.tokenize('/').size() >= 2 ? env.JOB_NAME.tokenize('/')[-2] : env.JOB_NAME
					def branchName = env.BRANCH_NAME ?: env.JOB_BASE_NAME
					if (env.PROJECT_NAME == null) {
						env.PROJECT_NAME = currentBuild.fullProjectName ?: "Jenkins Build"
					}

					build job: 'jenkins', parameters: [
							string(name: 'projectName', value: "${projectName}"),
							string(name: 'branchName', value: "${branchName}"),
							string(name: 'buildUrl', value: projectUrl)
					]
				}
			}
		}
	}
}
